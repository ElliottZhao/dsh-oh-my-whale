{
  "degradationCodes": [
    "llm_not_configured",
    "role_unconfigured",
    "recall_timeout",
    "extraction_failed",
    "index_unavailable",
    "core_unreachable",
    "outbound_blocked",
    "injection_deadline",
    "extraction_timeout",
    "extraction_provider_error",
    "extraction_invalid_json",
    "extraction_schema_mismatch",
    "evidence_not_found",
    "extraction_empty_response",
    "extraction_unavailable"
  ],
  "degradationMessages": {
    "core_unreachable": "连不上本机内核：本轮没有记忆，对话照常进行。",
    "evidence_not_found": "证据摘录在来源观察里找不到：整条拒绝写入。",
    "extraction_empty_response": "抽取返回了空内容：这批观察没有被理解。",
    "extraction_failed": "抽取失败：这批观察没有被理解，原样保留以便重抽。",
    "extraction_invalid_json": "抽取输出不是合法 JSON：这批观察没有被理解。",
    "extraction_provider_error": "抽取 provider 报错：这批观察没有被理解。",
    "extraction_schema_mismatch": "抽取输出结构不符：不合格的条目被拒绝，合格的条目照常写入。",
    "extraction_timeout": "抽取调用超时：这批观察没有被理解。",
    "extraction_unavailable": "抽取角色不可用：这一轮只记录观察，不做理解。",
    "index_unavailable": "向量或重排能力不可用：已退回全文检索基线。",
    "injection_deadline": "注入超过了自建 deadline：本轮放弃注入，回合继续。",
    "llm_not_configured": "没有配置语言模型：这一轮只记录观察，不做理解。",
    "outbound_blocked": "出站目标不在白名单：请求被拒绝，未发出。",
    "recall_timeout": "召回超过了预算：本轮按无记忆继续，不阻塞回合。",
    "role_unconfigured": "所需的能力角色没有绑定 provider：这一步被跳过。"
  },
  "injectionSkipCodes": [
    "budget_exhausted",
    "duplicate",
    "low_score",
    "abstained"
  ],
  "protocolVersion": "1.1.0",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
      "Capability": {
        "description": "Provider 能提供的模型能力类别，按能力而非业务划分。",
        "enum": [
          "llm",
          "embedding",
          "crossEncoder",
          "decision"
        ],
        "type": "string"
      },
      "CoreIdentity": {
        "description": "两端共享的版本与进程信息。握手响应与 ready 行都平铺这几个字段。",
        "properties": {
          "coreVersion": {
            "type": "string"
          },
          "protocolVersion": {
            "type": "string"
          },
          "schemaVersion": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "startedAt": {
            "description": "本次进程启动的时间；重启会变。",
            "type": "string"
          }
        },
        "required": [
          "protocolVersion",
          "coreVersion",
          "schemaVersion",
          "startedAt"
        ],
        "type": "object"
      },
      "CreateObservationRequest": {
        "additionalProperties": false,
        "description": "一条待写入的 Observation；未给出事件时间时，Core 用摄入时刻。",
        "properties": {
          "content": {
            "type": "string"
          },
          "occurredAt": {
            "default": null,
            "description": "事件发生的时刻（RFC3339）。省略时 Core 用摄入时刻，两者不混为一谈。",
            "type": [
              "string",
              "null"
            ]
          },
          "sessionId": {
            "description": "会话标识；同一会话重复摄入由此归并（去重在 #8 完整实现）。",
            "type": "string"
          },
          "source": {
            "description": "来源，例如 `host.message`、`tool.call`。",
            "type": "string"
          },
          "speaker": {
            "default": null,
            "description": "说话者或产生者；工具事件可省略。",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "sessionId",
          "source",
          "content"
        ],
        "type": "object"
      },
      "CredentialKind": {
        "description": "凭据引用的种类：只存引用，不存密钥值。",
        "oneOf": [
          {
            "const": "env",
            "description": "环境变量的名字。",
            "type": "string"
          },
          {
            "const": "file",
            "description": "只属于 Core 的密钥文件路径。",
            "type": "string"
          }
        ]
      },
      "CredentialRef": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/definitions/CredentialKind"
          },
          "reference": {
            "description": "`env` 时是环境变量名，`file` 时是文件路径；都不含密钥值。",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "reference"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "error": {
            "$ref": "#/definitions/ErrorPayload"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorPayload": {
        "properties": {
          "code": {
            "type": "string"
          },
          "details": true,
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "EstimateTokensRequest": {
        "additionalProperties": false,
        "description": "估算一段文本的 token 数。口径由 Core 的 `tokens` 模块唯一实现。",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      },
      "EstimateTokensResponse": {
        "description": "估算结果。`wHan` 是本次采用的汉字倍率，便于调用方知道预算口径。",
        "properties": {
          "messageTokens": {
            "description": "按 DSH `estimateMessage()` 口径的整条消息 token 数（文本密度 + 8）。",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "tokens": {
            "description": "文本密度 token 数，预算判定用这个值。",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "wHan": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "tokens",
          "messageTokens",
          "wHan"
        ],
        "type": "object"
      },
      "HandshakeRequest": {
        "additionalProperties": false,
        "properties": {
          "adapterVersion": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "protocolVersion": {
            "type": "string"
          }
        },
        "required": [
          "protocolVersion"
        ],
        "type": "object"
      },
      "HandshakeResponse": {
        "description": "握手成功时返回的 Core 身份。",
        "properties": {
          "coreVersion": {
            "type": "string"
          },
          "protocolVersion": {
            "type": "string"
          },
          "schemaVersion": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "startedAt": {
            "description": "本次进程启动的时间；重启会变。",
            "type": "string"
          }
        },
        "required": [
          "protocolVersion",
          "coreVersion",
          "schemaVersion",
          "startedAt"
        ],
        "type": "object"
      },
      "InjectedItem": {
        "additionalProperties": false,
        "description": "注入解释里的一条入选条目：id、分数、路径与预算占用。",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "path": {
            "description": "这条的贡献来自哪条路径：`lexical` / `semantic` / `rerank`。",
            "type": "string"
          },
          "score": {
            "format": "double",
            "type": "number"
          },
          "tokenCount": {
            "description": "这条在本轮 View 里占用的 token 数，口径由 #29 的 Core 实现给出。",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "itemId",
          "score",
          "path",
          "tokenCount"
        ],
        "type": "object"
      },
      "InjectionExplanation": {
        "additionalProperties": false,
        "description": "一轮注入的完整解释，可直接落成一张表。\n\n字段足以回答「本轮为什么注入这些、为什么没注入那些」：入选条目的 id、分数、\n路径与 token 占用，被跳过条目的原因，以及本轮整体预算与发生过的降级编码。",
        "properties": {
          "budgetTokens": {
            "description": "本轮允许的 token 预算。",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "degraded": {
            "description": "本轮发生过的降级编码；正常轮为空。",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/definitions/InjectedItem"
            },
            "type": "array"
          },
          "sessionId": {
            "type": "string"
          },
          "skipped": {
            "items": {
              "$ref": "#/definitions/SkippedRecall"
            },
            "type": "array"
          },
          "tokenCount": {
            "description": "本轮注入消耗的 token 数。",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "turn": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "turn",
          "sessionId",
          "items",
          "skipped",
          "tokenCount",
          "budgetTokens",
          "degraded"
        ],
        "type": "object"
      },
      "LedgerKind": {
        "description": "Ledger 条目的类别：每次出站、每次注入、每次降级、每次写入都各记一类。\n\n降级编码表见 [`crate::degrade`]；本类型只定义分类，不定义具体编码。",
        "oneOf": [
          {
            "const": "outbound",
            "description": "一次真实出站调用：用途、provider、模型、时间。",
            "type": "string"
          },
          {
            "const": "injection",
            "description": "一轮记忆注入：注入了什么、为什么、占了哪些预算。",
            "type": "string"
          },
          {
            "const": "degradation",
            "description": "一次降级：编码见 `degrade` 模块。",
            "type": "string"
          },
          {
            "const": "change",
            "description": "一次状态变更：写入条目、置失效、确认删除等。",
            "type": "string"
          }
        ]
      },
      "Observation": {
        "description": "已落盘的 Observation。`occurredAt` 是事件时刻，由请求给出或用摄入时刻补。",
        "properties": {
          "content": {
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "occurredAt": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "sessionId",
          "source",
          "content",
          "occurredAt"
        ],
        "type": "object"
      },
      "ObservationList": {
        "properties": {
          "observations": {
            "items": {
              "$ref": "#/definitions/Observation"
            },
            "type": "array"
          }
        },
        "required": [
          "observations"
        ],
        "type": "object"
      },
      "ProviderConfig": {
        "additionalProperties": false,
        "description": "Core 自持的 provider 配置；出站白名单等于这里的 endpoint 集合。",
        "properties": {
          "providers": {
            "default": [],
            "items": {
              "$ref": "#/definitions/ProviderEntry"
            },
            "type": "array"
          },
          "roles": {
            "default": [],
            "items": {
              "$ref": "#/definitions/RoleChain"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ProviderConfigSnapshot": {
        "description": "读取或写入配置后的视图：补上未配置的角色、凭据取不到的 provider 与派生的出站白名单。",
        "properties": {
          "degradedProviders": {
            "description": "凭据引用此刻取不到的 provider；它们仍在白名单里，但用到时按 ADR-0003 降级。",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "outboundWhitelist": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "providers": {
            "items": {
              "$ref": "#/definitions/ProviderEntry"
            },
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/definitions/RoleChain"
            },
            "type": "array"
          },
          "unconfiguredRoles": {
            "description": "没有任何角色绑定的能力角色；显式列出来，不隐式挑一个 provider。",
            "items": {
              "$ref": "#/definitions/Role"
            },
            "type": "array"
          }
        },
        "required": [
          "providers",
          "roles",
          "unconfiguredRoles",
          "degradedProviders",
          "outboundWhitelist"
        ],
        "type": "object"
      },
      "ProviderEntry": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "$ref": "#/definitions/Capability"
            },
            "type": "array"
          },
          "credential": {
            "$ref": "#/definitions/CredentialRef"
          },
          "endpoint": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "endpoint",
          "capabilities",
          "credential"
        ],
        "type": "object"
      },
      "ReadyLine": {
        "description": "Core 就绪后写到 stdout 的那一行。Adapter 与测试脚本都从它取端口。",
        "properties": {
          "coreVersion": {
            "type": "string"
          },
          "dataFile": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "pid": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "protocolVersion": {
            "type": "string"
          },
          "schemaVersion": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "startedAt": {
            "description": "本次进程启动的时间；重启会变。",
            "type": "string"
          }
        },
        "required": [
          "event",
          "endpoint",
          "dataFile",
          "pid",
          "protocolVersion",
          "coreVersion",
          "schemaVersion",
          "startedAt"
        ],
        "type": "object"
      },
      "Role": {
        "description": "Core 内部对某类工作的具名需求。",
        "oneOf": [
          {
            "const": "extraction",
            "description": "Observation → 候选 Memory Item；不做合并、不判冲突。",
            "type": "string"
          },
          {
            "const": "queryRewrite",
            "description": "查询改写：把用户问题改写成更适合检索的形式。",
            "type": "string"
          },
          {
            "const": "ranking",
            "description": "排序：给候选条目重排。",
            "type": "string"
          },
          {
            "const": "abstention",
            "description": "弃权判定：判断这一轮该不该答。",
            "type": "string"
          },
          {
            "const": "consolidation",
            "description": "整理：合并重复、让过时事实失效、产出删除提案。",
            "type": "string"
          },
          {
            "const": "insight",
            "description": "提炼：把成功的做法或失败教训提炼成 Insight 草案。",
            "type": "string"
          }
        ]
      },
      "RoleBinding": {
        "additionalProperties": false,
        "description": "能力角色的一项绑定：某 provider 的某条能力。",
        "properties": {
          "capability": {
            "$ref": "#/definitions/Capability"
          },
          "provider": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "capability"
        ],
        "type": "object"
      },
      "RoleChain": {
        "additionalProperties": false,
        "description": "一个角色的有序 fallback 链。",
        "properties": {
          "chain": {
            "items": {
              "$ref": "#/definitions/RoleBinding"
            },
            "type": "array"
          },
          "role": {
            "$ref": "#/definitions/Role"
          }
        },
        "required": [
          "role",
          "chain"
        ],
        "type": "object"
      },
      "SkippedRecall": {
        "additionalProperties": false,
        "description": "注入解释里「为什么没注入那一条」：候选 id 与稳定的跳过原因。\n\n跳过原因是正常行为（去重、低分、弃权、预算），不是降级；降级另见\n[`crate::degrade`]。",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "reason": {
            "description": "稳定编码，取值见 `degrade::SKIP_ALL`。",
            "type": "string"
          }
        },
        "required": [
          "itemId",
          "reason"
        ],
        "type": "object"
      }
    },
    "description": "导出 JSON Schema 时把全部 wire 类型收进来的根对象。\n\n它只服务代码生成，不出现在任何请求或响应里。",
    "properties": {
      "capability": {
        "$ref": "#/definitions/Capability"
      },
      "coreIdentity": {
        "$ref": "#/definitions/CoreIdentity"
      },
      "createObservationRequest": {
        "$ref": "#/definitions/CreateObservationRequest"
      },
      "credentialKind": {
        "$ref": "#/definitions/CredentialKind"
      },
      "credentialRef": {
        "$ref": "#/definitions/CredentialRef"
      },
      "errorBody": {
        "$ref": "#/definitions/ErrorBody"
      },
      "errorPayload": {
        "$ref": "#/definitions/ErrorPayload"
      },
      "estimateTokensRequest": {
        "$ref": "#/definitions/EstimateTokensRequest"
      },
      "estimateTokensResponse": {
        "$ref": "#/definitions/EstimateTokensResponse"
      },
      "handshakeRequest": {
        "$ref": "#/definitions/HandshakeRequest"
      },
      "handshakeResponse": {
        "$ref": "#/definitions/HandshakeResponse"
      },
      "injectedItem": {
        "$ref": "#/definitions/InjectedItem"
      },
      "injectionExplanation": {
        "$ref": "#/definitions/InjectionExplanation"
      },
      "ledgerKind": {
        "$ref": "#/definitions/LedgerKind"
      },
      "observation": {
        "$ref": "#/definitions/Observation"
      },
      "observationList": {
        "$ref": "#/definitions/ObservationList"
      },
      "providerConfig": {
        "$ref": "#/definitions/ProviderConfig"
      },
      "providerConfigSnapshot": {
        "$ref": "#/definitions/ProviderConfigSnapshot"
      },
      "providerEntry": {
        "$ref": "#/definitions/ProviderEntry"
      },
      "readyLine": {
        "$ref": "#/definitions/ReadyLine"
      },
      "role": {
        "$ref": "#/definitions/Role"
      },
      "roleBinding": {
        "$ref": "#/definitions/RoleBinding"
      },
      "roleChain": {
        "$ref": "#/definitions/RoleChain"
      },
      "skippedRecall": {
        "$ref": "#/definitions/SkippedRecall"
      }
    },
    "required": [
      "coreIdentity",
      "handshakeRequest",
      "handshakeResponse",
      "readyLine",
      "errorBody",
      "errorPayload",
      "createObservationRequest",
      "observation",
      "observationList",
      "estimateTokensRequest",
      "estimateTokensResponse",
      "ledgerKind",
      "injectedItem",
      "skippedRecall",
      "injectionExplanation",
      "capability",
      "role",
      "credentialKind",
      "credentialRef",
      "providerEntry",
      "roleBinding",
      "roleChain",
      "providerConfig",
      "providerConfigSnapshot"
    ],
    "title": "WireContract",
    "type": "object"
  }
}
